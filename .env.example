# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SESSION_SECRET: Optional HMAC signing secret for auth tokens (falls back to random key in memory).
SESSION_SECRET=""

# Optional Google OAuth Client ID for Google Sign-In
GOOGLE_CLIENT_ID=""

# Optional Payment Provider Keys (Stripe / Flutterwave / Paystack)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Optional SMTP settings for transactional password reset emails
SMTP_HOST=""
SMTP_USER=""
SMTP_PASS=""
